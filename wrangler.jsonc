{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name must match the Cloudflare project that is connected to this repo
  "name": "deflocklewis",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  // Serve the static site straight from the repo root
  "assets": {
    "directory": ".",
    // Unknown addresses show 404.html instead of a blank error
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
