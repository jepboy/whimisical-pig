{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in Cloudflare (whimisical-pig.jeepboy9478.workers.dev)
  "name": "whimisical-pig",
  // Shop back end: product list, Square checkout, admin API (see src/worker.js)
  "main": "src/worker.js",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  // Serve the static site straight from the repo root
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Unknown addresses show 404.html instead of a blank error
    "not_found_handling": "404-page",
    // These addresses go to the back end instead of the static files
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt", "/review"]
  },
  // Keep variables added in the Cloudflare dashboard when the site deploys
  // (otherwise each deploy from GitHub removes any that aren't listed below)
  "keep_vars": true,
  // Shop settings that aren't secret. Secrets (ADMIN_PASSWORD, SQUARE_ACCESS_TOKEN)
  // are added in the Cloudflare dashboard: Settings -> Variables and Secrets.
  "vars": {
    "SQUARE_LOCATION_ID": "6875TE29BSGD6",
    "SHIPPING_FEE": "5",
    // The Square app's Application ID (public). Turns on paying by card on our own page.
    "SQUARE_APPLICATION_ID": "sq0idp-4rtvDyFQUMdpIpsfpkZOMA",
    // shopVOX: website orders become Sales Leads in this pipeline, starting in this stage
    // (the Account ID and API Token are Secrets in the Cloudflare dashboard)
    "SHOPVOX_PIPELINE": "Sales Pipeline",
    "SHOPVOX_STAGE": "Assigned",
    // Every website lead is assigned to this shopVOX user (her name exactly as in shopVOX)
    "SHOPVOX_SALES_REP": "Katarina Carman",
    // /review forwards here (Google's "write a review" box), so printed QR signs never go stale
    "REVIEW_URL": "https://www.google.com/search?q=The+Whimsical+Pig+Watertown+NY&ludocid=3617294177447346575#lrd=0x89d86ffd090e832f:0x323335e39ed6818f,3,,,,"
  },
  // No scheduled jobs (an empty list also removes the old daily one)
  "triggers": {
    "crons": []
  },
  // Shop database. Cloudflare creates it automatically on the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whimsical-pig-shop"
    }
  ]
}
