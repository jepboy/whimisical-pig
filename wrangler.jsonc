{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in Cloudflare (whimisical-pig.jeepboy9478.workers.dev)
  "name": "whimisical-pig",
  // Shop back end: product list, Square checkout, admin API (see src/worker.js)
  "main": "src/worker.js",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  // Serve the static site straight from the repo root
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Unknown addresses show 404.html instead of a blank error
    "not_found_handling": "404-page",
    // These addresses go to the back end instead of the static files
    "run_worker_first": ["/api/*"]
  },
  // Shop settings that aren't secret. Secrets (ADMIN_PASSWORD, SQUARE_ACCESS_TOKEN)
  // are added in the Cloudflare dashboard: Settings -> Variables and Secrets.
  "vars": {
    "SQUARE_LOCATION_ID": "6875TE29BSGD6",
    "SHIPPING_FEE": "5",
    // The Square app's Application ID (public). Turns on paying by card on our own page.
    "SQUARE_APPLICATION_ID": ""
  },
  // Shop database. Cloudflare creates it automatically on the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whimsical-pig-shop"
    }
  ]
}
